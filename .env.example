# ==============================================================================
# Input Automation - Environment Configuration
# Stage 1: Source (RSS / Web / Clips) -> Reel Video -> Google Drive Staging
# ==============================================================================

# Server
PORT=3001
NODE_ENV=development

# MongoDB (Shared with Output Automation for state synchronization)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=news_automation

# Google Cloud OAuth (Google Drive Upload)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REFRESH_TOKEN=1//04your-long-lived-oauth2-refresh-token
# Or fallback API key (if public folder)
GOOGLE_DRIVE_API_KEY=

# Default Target Google Drive Folder ID (where generated reels will be saved)
GDRIVE_FOLDER_ID=your_target_google_drive_folder_id

# Internal Background Cron Scheduler (Set to true to run automatically)
CRON_ENABLED=true
CRON_SCHEDULE="*/15 * * * *"

# Reel Rendering Settings
REEL_DEFAULT_DURATION=15
REEL_DEFAULT_THEME=canva-studio-rotate
REEL_RESOLUTION=1080p
MAX_ARTICLE_AGE_HOURS=24
DATA_DIR=./data

# Pixabay Stock B-Roll Video API Key
PIXABAY_API_KEY=your_pixabay_api_key

# Dry Run Switch (Simulates Drive upload without modifying remote Drive)
DRY_RUN=false

# TTS Voiceover Priority: FreeLLMAPI -> ElevenLabs -> Cartesia -> Murf AI -> EasyVoice / Microsoft Edge TTS
LLM_API_KEY=your_freellmapi_unified_key
LLM_BASE_URL=https://your-public-freellmapi-url/v1
LLM_CHAT_MODEL=mistral-small-3.2-24b
LLM_SCRIPT_REWRITE=true
LLM_TTS_MODEL=auto
LLM_TTS_VOICE=

ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_VOICE_ID_BN=onwK4e9ZLuTAKqWW03F9

CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_MODEL_ID=sonic-3
CARTESIA_VERSION=2025-04-16
CARTESIA_VOICE_ID=a33f7a4c-100f-41cf-a1fd-5822e8fc253f
CARTESIA_VOICE_ID_BN=314be1d2-3d14-468d-be40-08a1af7df49d

MURF_API_KEY=your_murf_api_key
MURF_BASE_URL=https://global.api.murf.ai/v1
MURF_MODEL=falcon-2.1
MURF_VOICE_ID=Judith
MURF_VOICE_ID_BN=bn-IN-arnab
MURF_LOCALE_EN=en-US
MURF_LOCALE_BN=bn-IN

EASYVOICE_API_KEY=your_easyvoice_api_key
EASYVOICE_BASE_URL=https://easyvoice.ae/api/v1
EASYVOICE_MODEL=kokoro-82m
EASYVOICE_VOICE=af_aoede
